{
    "name": "adso/test-simple-stock-flow-api",
    "description": "Simple Stock Flow API - hexagonal architecture on Laravel 11",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "laravel/framework": "^11.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": { "psr-4": { "App\\": "app/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "test": "pest",
        "arch": "pest tests/Architecture",
        "lint": "pint --test",
        "fix": "pint",
        "stan": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
